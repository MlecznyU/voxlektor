from collections.abc import Callable, Iterable
from typing import Any, Self

class tqdm:
    n: float
    total: float | None
    desc: str
    disable: bool
    def __init__(self, *args: object, **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
    def update(self, n: float | None = 1) -> bool | None: ...
    def refresh(self, nolock: bool = False, lock_args: object = None) -> None: ...
    def close(self) -> None: ...
    def set_description(self, desc: str | None = None, refresh: bool = True) -> None: ...
    def set_description_str(self, desc: str | None = None, refresh: bool = True) -> None: ...
    def set_postfix_str(self, s: str = "", refresh: bool = True) -> None: ...
    @property
    def format_dict(self) -> dict[str, Any]: ...

def _create_progress_bar(
    *, cls: type[object], log_level: int, name: str | None = None, **kwargs: object
) -> Any: ...
def hf_thread_map[T, R](
    fn: Callable[[T], R],
    iterable: Iterable[T],
    *,
    max_workers: int | None = None,
    tqdm_class: type[object] | None = None,
    **tqdm_kwargs: object,
) -> list[R]: ...
